<?php

declare(strict_types=1);

use Drupal\canvas\Entity\Page;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Session\AccountInterface;

/**
 * Implements hook_entity_field_access().
 */
function canvas_test_field_access_entity_field_access(string $operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResultInterface {
  if ($field_definition->getTargetEntityTypeId() === Page::ENTITY_TYPE_ID
      && $field_definition->getName() == 'components'
      && $operation == 'edit'
  ) {
    return AccessResult::forbiddenIf(
      condition: !$account->hasPermission('edit canvas page components'),
      reason: 'You do not have permission to edit this field.'
    )->cachePerPermissions();
  }
  if ($field_definition->getTargetEntityTypeId() === 'node'
    && $field_definition->getName() == 'title'
    && $operation == 'edit'
  ) {
    return AccessResult::forbiddenIf(
      condition: !$account->hasPermission('edit canvas page components'),
      reason: 'You do not have permission to edit this field.'
    )->cachePerPermissions();
  }

  // A field that only those who may edit components can view.
  if ($field_definition->getTargetEntityTypeId() === 'node'
    && $field_definition->getName() == 'field_view_restricted'
    && $operation == 'view'
  ) {
    return AccessResult::forbiddenIf(
      condition: !$account->hasPermission('edit canvas page components'),
      reason: 'You do not have permission to view this field.'
    )->cachePerPermissions();
  }

  // A field that only a permission of its own, which has no bearing on editing,
  // lets a user view.
  if ($field_definition->getTargetEntityTypeId() === 'node'
    && $field_definition->getName() == 'field_secret_reference'
    && $operation == 'view'
  ) {
    return AccessResult::forbiddenIf(
      condition: !$account->hasPermission('view secret reference field'),
      reason: 'You do not have permission to view this field.'
    )->cachePerPermissions();
  }

  return AccessResult::neutral();
}
