{#
/**
 * @file
 * Default theme implementation for the controls in the label of a prop.
 *
 * Available variables:
 * - prop_label_data: JSON, the data of the controls, handed over by whatever
 *   altered the form.
 */
#}
<drupal-canvas-prop-label-controls
  prop_label_data="{{ prop_label_data }}"
>
</drupal-canvas-prop-label-controls>
